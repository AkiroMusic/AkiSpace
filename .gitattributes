# Normalize line endings: everything textual is LF in the repo; Windows-native
# script formats are checked out as CRLF.
* text=auto

# Source
*.cs text
*.xaml text
*.csproj text
*.slnx text
*.manifest text

# Documentation
*.md text
*.txt text
LICENSE text

# Configuration
*.json text
*.yml text
.editorconfig text
.gitattributes text
.gitignore text

# Scripts
*.ps1 text eol=crlf
*.sh text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets
*.png binary
*.ico binary
*.exe binary
*.dll binary
*.pdb binary
*.zip binary
