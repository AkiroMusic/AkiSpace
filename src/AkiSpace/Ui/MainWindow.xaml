<Window x:Class="AkiSpace.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AkiSpace.Ui.Controls"
        Title="AkiSpace — 桌面分身" Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.BgBase}"
        UseLayoutRounding="True">
    <Grid>
        <ui:AuroraBackdrop />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Toolbar (structural glass bar) -->
            <Border Grid.Row="0" Background="{DynamicResource Brush.GlassBg}"
                    BorderBrush="{DynamicResource Brush.GlassBorder}" BorderThickness="0,0,0,1"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnConnect" Content="连接" Style="{StaticResource Btn.Primary}"
                            MinWidth="96" Click="OnConnect" />
                    <Button x:Name="BtnDisconnect" Content="断开" Style="{StaticResource Btn.Ghost}"
                            MinWidth="90" Margin="10,0,0,0" IsEnabled="False" Click="OnDisconnect" />
                    <Button x:Name="BtnTerminate" Content="终止" Style="{StaticResource Btn.Ghost}"
                            MinWidth="90" Margin="10,0,0,0" IsEnabled="False" Click="OnTerminate" />
                    <Button x:Name="BtnGameMouse" Content="游戏鼠标" Style="{StaticResource Btn.Ghost}"
                            MinWidth="100" Margin="10,0,0,0" Visibility="Collapsed" IsEnabled="False"
                            Click="OnGameMouse" />
                    <Button x:Name="BtnLaunch" Content="启动程序" Style="{StaticResource Btn.Ghost}"
                            MinWidth="100" Margin="10,0,0,0" IsEnabled="False" Click="OnLaunch" />
                    <Button x:Name="BtnSetup" Content="环境检查" Style="{StaticResource Btn.Ghost}"
                            MinWidth="100" Margin="10,0,0,0" Click="OnSetup" />
                    <Button x:Name="BtnSettings" Content="设置" Style="{StaticResource Btn.Ghost}"
                            MinWidth="84" Margin="10,0,0,0" Click="OnSettings" />
                </StackPanel>
            </Border>

            <!-- Status row -->
            <Border Grid.Row="1" Padding="16,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LblChildSession" Grid.Column="0" Style="{StaticResource Text.Secondary}"
                               Text="子会话: 检测中" />
                    <TextBlock x:Name="LblConnection" Grid.Column="1" Style="{StaticResource Text.Secondary}"
                               Text="连接: 未连接" />
                    <TextBlock x:Name="LblWrapper" Grid.Column="2" Style="{StaticResource Text.Secondary}"
                               Text="RDP 解锁: 检测中" />
                    <TextBlock x:Name="LblPerformance" Grid.Column="3" Style="{StaticResource Text.Secondary}"
                               Text="CPU: 0% | 内存: 0 MB" />
                </Grid>
            </Border>

            <!-- RDP viewer area (the WindowsFormsHost is injected here by the shell) -->
            <Grid Grid.Row="2" Margin="16,8,16,12">
                <Border Background="Black"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Md}" />
                <Grid x:Name="ViewerArea" Margin="1" />
            </Grid>

            <!-- Bottom status bar (structural glass bar) -->
            <Border Grid.Row="3" Background="{DynamicResource Brush.GlassBg}"
                    BorderBrush="{DynamicResource Brush.GlassBorder}" BorderThickness="0,1,0,0"
                    Padding="16,5">
                <DockPanel LastChildFill="False">
                    <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Style="{StaticResource Text.Secondary}"
                               Text="就绪" />
                    <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource Text.Secondary}">
                        <Hyperlink Click="OnGitHubLink" Foreground="{DynamicResource Brush.Accent}">
                            GitHub: AkiroMusic/AkiSpace
                        </Hyperlink>
                    </TextBlock>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
