<chrome:ChromeWindow x:Class="AkiSpace.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:AkiSpace.Ui"
        xmlns:ui="clr-namespace:AkiSpace.Ui.Controls"
        xmlns:loc="clr-namespace:AkiSpace.Common"
        Title="{loc:Loc Set_Title}" Width="640" Height="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Brush.BgBase}">
    <Grid>
        <ui:AuroraBackdrop />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Background="Transparent"
                          ui:SmoothScroll.IsEnabled="True">
                <StackPanel Margin="24">

                    <!-- 连接配置 -->
                    <ui:GlassCard Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.CardTitle}" Text="{loc:Loc Set_ConnCard}" />
                            <TextBlock Style="{StaticResource Text.CardSubtitle}" Text="{loc:Loc Set_ConnSub}"
                                       Margin="0,2,0,0" />
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource RowLabel.Top}" Text="{loc:Loc Set_Mode}" />
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="RdoStandard" Style="{StaticResource Input.Radio}"
                                                     Content="{loc:Loc Set_ModeStandard}" GroupName="ConnMode" IsChecked="True"
                                                     Checked="OnModeChanged" Unchecked="OnModeChanged" />
                                        <RadioButton x:Name="RdoChild" Style="{StaticResource Input.Radio}"
                                                     Content="{loc:Loc Set_ModeChild}" GroupName="ConnMode" Margin="8,0,0,0" Checked="OnModeChanged" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Text.Tertiary}" Text="{loc:Loc Set_ModeHint}"
                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock x:Name="StandardWarn" Style="{StaticResource Text.Secondary}"
                                               Foreground="{DynamicResource Brush.Warning}" Visibility="Collapsed"
                                               Text="{loc:Loc Set_StandardWarn}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource RowLabel.Top}" Text="{loc:Loc Set_Width}" Margin="0,14,16,0" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,14,0,0">
                                    <ui:NumberBox x:Name="NumWidth" Minimum="800" Maximum="7680" Increment="160" Width="160" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" Text="{loc:Loc Set_PxHint}" Margin="0,3,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource RowLabel.Top}" Text="{loc:Loc Set_Height}" Margin="0,14,16,0" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,14,0,0">
                                    <ui:NumberBox x:Name="NumHeight" Minimum="600" Maximum="4320" Increment="120" Width="160" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" Text="{loc:Loc Set_PxHint}" Margin="0,3,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource RowLabel.Top}" Text="{loc:Loc Set_Depth}" Margin="0,14,16,0" />
                                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,14,0,0">
                                    <ui:NumberBox x:Name="NumColorDepth" Minimum="8" Maximum="32" Increment="8" Width="120" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" Text="{loc:Loc Set_DepthHint}" Margin="0,3,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource RowLabel.Top}" Text="{loc:Loc Set_Port}" Margin="0,14,16,0" />
                                <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,14,0,0">
                                    <ui:NumberBox x:Name="NumPort" Minimum="1" Maximum="65535" Increment="1" Width="160" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" Text="{loc:Loc Set_PortHint}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,14,0,0">
                                    <CheckBox x:Name="ChkSmartSizing" Style="{StaticResource Input.CheckBox}" Content="{loc:Loc Set_ChkSmart}" />
                                    <CheckBox x:Name="ChkShortcuts" Style="{StaticResource Input.CheckBox}" Content="{loc:Loc Set_ChkShortcuts}" Margin="0,9,0,0" />
                                    <CheckBox x:Name="ChkAudio" Style="{StaticResource Input.CheckBox}" Content="{loc:Loc Set_ChkAudio}" Margin="0,9,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ui:GlassCard>

                    <!-- 行为设置 -->
                    <ui:GlassCard Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.CardTitle}" Text="{loc:Loc Set_BehaviorCard}" />
                            <TextBlock Style="{StaticResource Text.CardSubtitle}" Text="{loc:Loc Set_BehaviorSub}"
                                       Margin="0,2,0,0" />
                            <StackPanel Margin="0,16,0,0">
                                <CheckBox x:Name="ChkAutoConnect" Style="{StaticResource Input.CheckBox}" Content="{loc:Loc Set_ChkAutoConnect}" />
                                <CheckBox x:Name="ChkLogoff" Style="{StaticResource Input.CheckBox}" Content="{loc:Loc Set_ChkLogoff}" Margin="0,9,0,0" />
                                <CheckBox x:Name="ChkMinimizeTray" Style="{StaticResource Input.CheckBox}" Content="{loc:Loc Set_ChkTray}" Margin="0,9,0,0" />
                                <CheckBox x:Name="ChkPerformance" Style="{StaticResource Input.CheckBox}" Content="{loc:Loc Set_ChkPerf}" Margin="0,9,0,0" />
                                <CheckBox x:Name="ChkHotkeys" Style="{StaticResource Input.CheckBox}" Margin="0,9,0,0" MaxWidth="520">
                                    <TextBlock Text="{loc:Loc Set_ChkHotkeys}" TextWrapping="Wrap" />
                                </CheckBox>
                                <CheckBox x:Name="ChkGameMouse" Style="{StaticResource Input.CheckBox}" Margin="0,9,0,0" MaxWidth="520">
                                    <TextBlock Text="{loc:Loc Set_ChkGameMouse}" TextWrapping="Wrap" />
                                </CheckBox>
                            </StackPanel>
                        </StackPanel>
                    </ui:GlassCard>

                    <!-- 分身账户 -->
                    <ui:GlassCard Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.CardTitle}" Text="{loc:Loc Set_AccountCard}" />
                            <TextBlock Style="{StaticResource Text.CardSubtitle}" Text="{loc:Loc Set_AccountSub}"
                                       Margin="0,2,0,0" />
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource RowLabel.Top}" Text="{loc:Loc Set_Username}" Margin="0,0,16,9" />
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,9">
                                    <TextBox x:Name="TxtUsername" Style="{StaticResource Input.TextBox}" Width="260" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" Text="{loc:Loc Set_UsernameHint}" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource RowLabel.Top}" Text="{loc:Loc Set_Password}" />
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <PasswordBox x:Name="PbPassword" Style="{StaticResource Input.PasswordBox}" Width="260" HorizontalAlignment="Left" />
                                    <TextBlock Style="{StaticResource Text.Tertiary}" Text="{loc:Loc Set_PasswordHint}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ui:GlassCard>

                    <!-- 外观（语言 + 配色包） -->
                    <ui:GlassCard Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.CardTitle}" Text="{loc:Loc Set_LookCard}" />
                            <TextBlock Style="{StaticResource Text.CardSubtitle}" Text="{loc:Loc Set_LookSub}"
                                       Margin="0,2,0,0" />

                            <TextBlock Style="{StaticResource RowLabel}" Text="{loc:Loc Set_Language}" Margin="0,16,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <RadioButton x:Name="RdoLangEn" Style="{StaticResource Input.Radio}" MinWidth="150"
                                             Content="English" Tag="en" GroupName="Language" Checked="OnLanguagePreview" />
                                <RadioButton x:Name="RdoLangZh" Style="{StaticResource Input.Radio}" MinWidth="150"
                                             Content="中文" Tag="zh" GroupName="Language" Margin="8,0,0,0" Checked="OnLanguagePreview" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Tertiary}" Text="{loc:Loc Set_LanguageHint}"
                                       Margin="0,3,0,0" />

                            <Border Height="1" Background="{DynamicResource Brush.Hairline}" Margin="0,16,0,0" />
                            <TextBlock Style="{StaticResource RowLabel}" Text="{loc:Loc Set_Theme}" Margin="0,16,0,0" />
                            <StackPanel Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RdoThemeDark" Style="{StaticResource Input.Radio}" MinWidth="150"
                                                 Content="{loc:Loc Set_ThemeDark}" Tag="dark" GroupName="ThemePack" Checked="OnThemePreview" />
                                    <RadioButton x:Name="RdoThemeAmber" Style="{StaticResource Input.Radio}" MinWidth="150"
                                                 Content="{loc:Loc Set_ThemeAmber}" Tag="amber" GroupName="ThemePack" Margin="8,0,0,0" Checked="OnThemePreview" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <RadioButton x:Name="RdoThemeMint" Style="{StaticResource Input.Radio}" MinWidth="150"
                                                 Content="{loc:Loc Set_ThemeMint}" Tag="mint" GroupName="ThemePack" Checked="OnThemePreview" />
                                    <RadioButton x:Name="RdoThemePearl" Style="{StaticResource Input.Radio}" MinWidth="150"
                                                 Content="{loc:Loc Set_ThemePearl}" Tag="pearl" GroupName="ThemePack" Margin="8,0,0,0" Checked="OnThemePreview" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,8,0,0"
                                       Text="{loc:Loc Set_ThemeHint}" />
                        </StackPanel>
                    </ui:GlassCard>

                    <!-- 自动启动 -->
                    <ui:GlassCard>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.CardTitle}" Text="{loc:Loc Set_AutoCard}" />
                            <TextBlock Style="{StaticResource Text.CardSubtitle}" Text="{loc:Loc Set_AutoSub}"
                                       Margin="0,2,0,0" />
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource RowLabel.Top}" Text="{loc:Loc Set_AutoPath}" />
                                <TextBox x:Name="TxtLaunchPath" Grid.Column="1" Style="{StaticResource Input.TextBox}" VerticalAlignment="Center" />
                                <Button x:Name="BtnBrowse" Grid.Column="2" Style="{StaticResource Btn.Ghost}"
                                        Content="{loc:Loc Set_Browse}" Margin="8,0,0,0" Click="OnBrowse" />
                            </Grid>
                        </StackPanel>
                    </ui:GlassCard>

                </StackPanel>
            </ScrollViewer>

            <!-- Bottom bar (structural glass bar) -->
            <Border Grid.Row="1" Background="{DynamicResource Brush.GlassBg}"
                    BorderBrush="{DynamicResource Brush.GlassBorder}" BorderThickness="0,1,0,0"
                    Padding="24,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Content="{loc:Loc Set_Cancel}" Style="{StaticResource Btn.Ghost}" MinWidth="90"
                            Click="OnCancel" IsCancel="True" />
                    <Button x:Name="BtnSave" Content="{loc:Loc Set_Save}" Style="{StaticResource Btn.Primary}" MinWidth="100"
                            Margin="10,0,0,0" Click="OnSave" IsDefault="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</chrome:ChromeWindow>
