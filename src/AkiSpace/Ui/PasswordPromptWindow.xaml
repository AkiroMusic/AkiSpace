<chrome:ChromeWindow x:Class="AkiSpace.Ui.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:AkiSpace.Ui"
        xmlns:ui="clr-namespace:AkiSpace.Ui.Controls"
        Title="AkiSpace — 分身账户密码"
        Width="440" SizeToContent="Height" MaxWidth="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="ToolWindow"
        Background="{DynamicResource Brush.BgBase}">
    <Grid>
        <ui:AuroraBackdrop />
        <StackPanel Margin="20">
            <TextBlock Style="{StaticResource Text.Base}" TextWrapping="Wrap"
                       Text="标准 RDP 模式需要分身账户的密码。AkiSpace 不再内置默认密码，请输入分身账户的密码（将使用 DPAPI 加密保存在本机设置中）：" />
            <PasswordBox x:Name="PbPassword" Margin="0,14,0,0" Style="{StaticResource Input.PasswordBox}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="确定" Style="{StaticResource Btn.Primary}" MinWidth="88" Click="OnOk"
                        IsDefault="True" />
                <Button Content="取消" Style="{StaticResource Btn.Ghost}" MinWidth="88" Margin="10,0,0,0"
                        Click="OnCancel" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</chrome:ChromeWindow>
