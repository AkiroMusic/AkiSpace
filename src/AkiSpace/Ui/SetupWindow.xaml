<chrome:ChromeWindow x:Class="AkiSpace.Ui.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:AkiSpace.Ui"
        xmlns:ui="clr-namespace:AkiSpace.Ui.Controls"
        xmlns:loc="clr-namespace:AkiSpace.Common"
        Title="{loc:Loc Env_Title}"
        Width="820" Height="720" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.BgBase}">
    <Grid>
        <ui:AuroraBackdrop />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Background="Transparent"
                          ui:SmoothScroll.IsEnabled="True">
                <StackPanel Margin="24">

                    <!-- 检查卡片 -->
                    <ui:GlassCard Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.CardTitle}" Text="{loc:Loc Env_CheckCard}" />
                            <TextBlock Style="{StaticResource Text.CardSubtitle}" Text="{loc:Loc Env_CheckSub}"
                                       Margin="0,2,0,0" />
                            <ItemsControl x:Name="ChecksList" Margin="0,16,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="300" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource Text.Base}"
                                                       Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" FontSize="12" Text="{Binding Status}"
                                                       Foreground="{Binding StatusBrush}" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource Text.Secondary}"
                                                       Text="{Binding Detail}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Detail}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ui:GlassCard>

                    <!-- 家庭版指南卡片（warning-tinted border） -->
                    <ui:GlassCard x:Name="HomeGuideCard" Margin="0,0,0,24"
                                  BorderBrush="{DynamicResource Brush.Warning}"
                                  Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.CardTitle}" Foreground="{DynamicResource Brush.Warning}"
                                       Text="{loc:Loc Env_HomeTitle}" />
                            <TextBlock Style="{StaticResource Text.CardSubtitle}" Text="{loc:Loc Env_HomeSub}"
                                       Margin="0,2,0,0" />
                            <Border Height="1" Background="{DynamicResource Brush.Hairline}" Margin="0,16,0,0" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,14,0,0" TextWrapping="Wrap"
                                       Text="{loc:Loc Env_HomeBody}" />
                            <TextBlock x:Name="LblTermsrvVersion" FontFamily="{StaticResource Font.Mono}"
                                       FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}"
                                       Margin="0,14,0,0" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource Btn.Ghost}" Content="{loc:Loc Env_OpenSergiye}"
                                        Click="OnOpenSergiye" Margin="0,0,10,10" />
                                <Button Style="{StaticResource Btn.Ghost}" Content="{loc:Loc Env_OpenSeba}"
                                        Click="OnOpenSebaxakerhtc" Margin="0,0,10,10" />
                                <Button Style="{StaticResource Btn.Ghost}" Content="{loc:Loc Env_CopyVer}"
                                        Click="OnCopyVersion" Margin="0,0,10,10" />
                                <Button Style="{StaticResource Btn.Ghost}" Content="{loc:Loc Env_CopyDiag}"
                                        Click="OnCopyDiagnostics" Margin="0,0,10,10" />
                            </WrapPanel>
                            <Button Style="{StaticResource Btn.Primary}" Content="{loc:Loc Env_RecheckInstalled}"
                                    Click="OnRecheck" Margin="0,8,0,0" HorizontalAlignment="Left" />
                        </StackPanel>
                    </ui:GlassCard>

                </StackPanel>
            </ScrollViewer>

            <!-- Bottom bar (structural glass bar) -->
            <Border Grid.Row="1" Background="{DynamicResource Brush.GlassBg}"
                    BorderBrush="{DynamicResource Brush.GlassBorder}" BorderThickness="0,1,0,0"
                    Padding="24,12">
                <DockPanel LastChildFill="False">
                    <Button x:Name="BtnClose" DockPanel.Dock="Right" Content="{loc:Loc Env_Close}" Style="{StaticResource Btn.Ghost}"
                            MinWidth="90" Click="OnClose" IsCancel="True" />
                    <Button x:Name="BtnFix" DockPanel.Dock="Right" Content="{loc:Loc Env_Fix}" Style="{StaticResource Btn.Primary}"
                            MinWidth="110" Margin="10,0,0,0" Click="OnFix" />
                    <Button x:Name="BtnCheck" DockPanel.Dock="Right" Content="{loc:Loc Env_Recheck}" Style="{StaticResource Btn.Ghost}"
                            MinWidth="110" Margin="10,0,0,0" Click="OnRecheck" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</chrome:ChromeWindow>
