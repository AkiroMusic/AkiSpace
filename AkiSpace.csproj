<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AkiSpace</RootNamespace>
    <AssemblyName>AkiSpace</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>AkiSpace.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Version>0.2.2</Version>
    <AssemblyTitle>AkiSpace — 桌面分身</AssemblyTitle>
    <Product>AkiSpace</Product>
    <Company>Akiro</Company>
    <Copyright>Copyright (c) 2026 Akiro</Copyright>
    <Description>AkiSpace - Desktop Clone (桌面分身)</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="AkiSpace.ico" Condition="Exists('AkiSpace.ico')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Compile Remove="test/**/*.cs;selftest/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.8" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="selftest" />
    <InternalsVisibleTo Include="tests" />
  </ItemGroup>

</Project>
